{
	admin off
	auto_https off

	servers {
		trusted_proxies static 127.0.0.1 ::1
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

:8091 {
	bind 127.0.0.1

	@pilot_host host {$PILOT_HOST}
	handle @pilot_host {
		@reverb path /app/*
		handle @reverb {
			reverse_proxy 127.0.0.1:8082
		}

		handle {
			reverse_proxy 127.0.0.1:8000
		}
	}

	handle {
		respond "Not found" 404
	}
}
