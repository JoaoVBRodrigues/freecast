<?xml version="1.0" encoding="UTF-8"?>
<frame width="24" height="24" autoScaleY="true" autoScaleX="true">
	<import file="../../consts.xml"/>
	
	<margins left="5" right="10"/>
	
	<draw>				
		<!-- Drop Down Mark 9x4 -->	
		
		<path left="15" top="10" right="24" bottom="14" zOrder="-2" mode="fit">
			<pathData>M1 2L5.5 6L10 2 </pathData>
			<anchors left="true" top="true" bottom="true" right="true"/>
			<stroke color="$(alert_color)" size="3"/>
		</path>				
							
		<!-- Left Vertical line 1x24 .. 14 points left padding -->
		
		<path left="0" top="0" right="1" bottom="24" zOrder="-2" mode="fit">
			<pathData>M 0 0 L 0 1 </pathData>
			<anchors left="true" top="true" bottom="true" right="true"/>
			<stroke color="$(alert_color)" size="0.75"/>
		</path>				
	</draw>
</frame>