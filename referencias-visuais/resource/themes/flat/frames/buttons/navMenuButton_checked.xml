		<rectangle left="0" top="0" right="56" bottom="47" xradius="0" yradius="0">
			<anchors left="true" top="true" bottom="true" right="true"/>
			<fill color="$(dark_bkg_color)"/>
		</rectangle>	
		
		<rectangle left="-6" top="0" right="6" bottom="47" xradius="0" yradius="0">
			<anchors left="true" top="true" bottom="true" right="false"/>
